{
  "name": "no-magic-babel",
  "version": "2.0.0",
  "private": true,
  "description": "There is no magic in Babel: a tiny compiler that builds a tree, edits it and prints it back, told as a scroll story.",
  "keywords": [
    "babel",
    "compiler",
    "ast",
    "acorn",
    "parser",
    "code-generation",
    "typescript",
    "javascript",
    "scrollytelling",
    "education"
  ],
  "homepage": "https://babel.avolkov.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/slimcandy/no-magic-babel.git"
  },
  "bugs": {
    "url": "https://github.com/slimcandy/no-magic-babel/issues"
  },
  "author": "Aleksei Volkov",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/demo.ts",
    "test": "vitest run",
    "check": "tsc",
    "dev": "vite",
    "prebuild": "sh scripts/fetch-fonts.sh",
    "build": "vite build"
  },
  "dependencies": {
    "acorn": "8.18.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.2",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
